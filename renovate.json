{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "automerge": true,
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "release.yml is generated by dist; update it with `dist generate`",
      "matchFileNames": [".github/workflows/release.yml"],
      "enabled": false
    }
  ]
}
